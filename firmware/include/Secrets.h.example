#ifndef SECRETS_H_EXAMPLE
#define SECRETS_H_EXAMPLE

// ==========================================================================
// TEMPLATE CONFIGURATION FILE - DO NOT COMMIT ACTUAL CREDENTIALS
// ==========================================================================
//
// IMPORTANT: 
// 1. Copy this file to Secrets.h
// 2. Fill in your actual WiFi SSID, password, and MQTT server
// 3. Secrets.h is gitignored and will not be committed to the repository
// 4. For Wokwi simulation, use the default values below
//
// ==========================================================================

// WiFi Credentials
#define WIFI_SSID "YOUR_WIFI_SSID"        // Replace with your WiFi network name
#define WIFI_PASS "YOUR_WIFI_PASSWORD"    // Replace with your WiFi password

// MQTT Configuration
#define MQTT_SERVER "192.168.0.103"       // MQTT broker IP address
                                           // For Wokwi: use your PC's IP (run: ipconfig)
                                           // For production: use your MQTT server address

// Device Identification (can be customized per device)
#define DEVICE_ID "ESP32_MAIN_001"

#endif // SECRETS_H_EXAMPLE
